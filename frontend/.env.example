# =============================================================================
# Velora ERP — Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ---------- API ----------
# Backend API base URL.
# In development with Vite proxy: leave empty (uses /api relative path)
# In production or when API is on a different origin: set the full URL
# VITE_API_BASE_URL=https://api.velora-erp.com/api

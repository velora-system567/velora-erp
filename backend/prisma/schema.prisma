  isDeleted       Boolean  @default(false) @map("is_deleted")

  maintenanceTasks MaintenanceTask[]

  @@unique([tenantId, machineCode])
  @@index([tenantId, companyId, isDeleted])
  @@map("machines")
}

model MaintenanceTask {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  machineId     String   @map("machine_id") @db.Uuid
  taskNumber    String   @map("task_number")
  taskType      String   @map("task_type")
  description   String
  scheduledDate DateTime @map("scheduled_date")
  completedDate DateTime? @map("completed_date")
  status        String   @default("SCHEDULED")
  assignedTo    String?  @map("assigned_to")
  costPaise     Int      @default(0) @map("cost_paise")
  notes         String?
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  isDeleted     Boolean  @default(false) @map("is_deleted")

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([tenantId, taskNumber])
  @@index([tenantId, companyId, machineId, isDeleted])
  @@map("maintenance_tasks")
}

model QualityCheck {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  workOrderId  String        @map("work_order_id") @db.Uuid
  qcNumber     String        @map("qc_number")
  inspectedQty Decimal       @map("inspected_qty") @db.Decimal(18, 3)
  passedQty    Decimal       @map("passed_qty") @db.Decimal(18, 3)
  failedQty    Decimal       @map("failed_qty") @db.Decimal(18, 3)
  reworkQty    Decimal       @default(0) @map("rework_qty") @db.Decimal(18, 3)
  result       QualityStatus @default(PASS)
  defects      Json?
  inspector    String?
  notes        String?
  checkedAt    DateTime      @default(now()) @map("checked_at")
  createdBy    String?       @map("created_by") @db.Uuid
  updatedBy    String?       @map("updated_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  isDeleted    Boolean       @default(false) @map("is_deleted")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([tenantId, qcNumber])
  @@index([tenantId, companyId, workOrderId, isDeleted])
  @@map("quality_checks")
}

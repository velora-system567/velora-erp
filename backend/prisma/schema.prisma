generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleName {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES_MANAGER
  SALESMAN
  STORE_KEEPER
  PURCHASE_MANAGER
  PRODUCTION_OPERATOR
  HR_MANAGER
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED
  SERVICE
  CONSUMABLE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum PaymentMode {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  CARD
}

enum StockTransactionType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
}

enum LeadStatus {
  NEW
  QUALIFIED
  LOST
  CONVERTED
}

enum GstTreatment {
  INTRA_STATE
  INTER_STATE
}

enum PaymentType {
  RECEIPT
  PAYMENT
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
}

enum RfqStatus {
  DRAFT
  SENT
  RECEIVED
  COMPARED
  CLOSED
}

enum GrnStatus {
  DRAFT
  INSPECTED
  APPROVED
  REJECTED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum QualityStatus {
  PASS
  FAIL
  REWORK
}
enum InventoryMovementType {
  OPENING_STOCK
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  RESERVE
  UNRESERVE
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum InventoryReferenceType {
  PURCHASE_ORDER
  SALES_ORDER
  GOODS_RECEIPT
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  PURCHASE_RETURN
  SALES_RETURN
  PRODUCTION_ORDER
  MANUAL
  OPENING_STOCK
}

enum InventoryMovementSource {
  WEB
  MOBILE
  BARCODE
  IMPORT
  API
  AI
}

enum InventoryItemStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  QUALITY_CHECK
  IN_TRANSIT
  BLOCKED
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  companies Company[]
  users     User[]
  roles     Role[]

  @@map("tenants")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  legalName String   @map("legal_name")
  gstin     String?
  panNumber String?  @map("pan_number")
  address   Json?
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isDeleted])
  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  code      String?
  address   Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([tenantId, companyId, isDeleted])
  @@map("branches")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  name         String
  email        String
  phone        String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isDeleted    Boolean  @default(false) @map("is_deleted")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  userRoles     UserRole[]
  userBranches  UserBranch[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId, isDeleted])
  @@map("users")
}

model UserBranch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, branchId])
  @@map("user_branches")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  branchId    String?      @map("branch_id") @db.Uuid
  name        UserRoleName
  description String?
  createdBy   String?      @map("created_by") @db.Uuid
  updatedBy   String?      @map("updated_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  isDeleted   Boolean      @default(false) @map("is_deleted")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, companyId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  key         String
  description String?
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  rolePermissions RolePermission[]

  @@unique([tenantId, key])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isDeleted    Boolean  @default(false) @map("is_deleted")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  tableName String   @map("table_name")
  recordId  String   @map("record_id") @db.Uuid
  action    String
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([tenantId, tableName, recordId])
  @@map("audit_logs")
}

model ItemCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  items Item[]

  @@unique([tenantId, companyId, name])
  @@map("item_categories")
}

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  symbol    String
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  items Item[]

  @@unique([tenantId, companyId, symbol])
  @@map("units_of_measure")
}

model Item {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  branchId        String?  @map("branch_id") @db.Uuid
  itemCode        String   @map("item_code")
  name            String
  description     String?
  itemType        ItemType @map("item_type")
  hsnCode         String?  @map("hsn_code")
  unitOfMeasureId String?  @map("unit_of_measure_id") @db.Uuid
  itemCategoryId  String?  @map("item_category_id") @db.Uuid
  purchasePrice   Int      @default(0) @map("purchase_price")
  sellingPrice    Int      @default(0) @map("selling_price")
  gstRate         Int      @default(18) @map("gst_rate")
  reorderLevel    Decimal? @map("reorder_level") @db.Decimal(18, 3)
  reorderQuantity Decimal? @map("reorder_quantity") @db.Decimal(18, 3)
  barcode         String?
  qrCode          String?  @map("qr_code")
  brand           String?
  imageUrl        String?  @map("image_url")
  attributes      Json?
  attachments     Json?
  notes           String?
  trackingMode    String   @default("NONE") @map("tracking_mode")
  lifecycleStatus String   @default("ACTIVE") @map("lifecycle_status")
  safetyStock     Decimal? @map("safety_stock") @db.Decimal(18, 3)
  eoqQuantity     Decimal? @map("eoq_quantity") @db.Decimal(18, 3)
  leadTimeDays    Int      @default(0) @map("lead_time_days")
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  isDeleted       Boolean  @default(false) @map("is_deleted")

  unitOfMeasure UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  category      ItemCategory?  @relation(fields: [itemCategoryId], references: [id])

  @@unique([tenantId, itemCode])
  @@index([tenantId, companyId, isDeleted])
  @@index([tenantId, barcode])
  @@index([tenantId, qrCode])
  @@map("items")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String
  gstin          String?
  panNumber      String?  @map("pan_number")
  billingAddress Json?    @map("billing_address")
  shippingAddress Json?   @map("shipping_address")
  creditLimit    Int      @default(0) @map("credit_limit")
  creditDays     Int      @default(0) @map("credit_days")
  paymentTerms   String?  @map("payment_terms")
  openingBalance Int      @default(0) @map("opening_balance")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  isDeleted      Boolean  @default(false) @map("is_deleted")

  @@index([tenantId, companyId, isDeleted])
  @@map("customers")
}

model Vendor {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String
  gstin          String?
  panNumber      String?  @map("pan_number")
  billingAddress Json?    @map("billing_address")
  shippingAddress Json?   @map("shipping_address")
  creditLimit    Int      @default(0) @map("credit_limit")
  creditDays     Int      @default(0) @map("credit_days")
  paymentTerms   String?  @map("payment_terms")
  openingBalance Int      @default(0) @map("opening_balance")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  isDeleted      Boolean  @default(false) @map("is_deleted")

  @@index([tenantId, companyId, isDeleted])
  @@map("vendors")
}

model ChartOfAccount {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  branchId  String?     @map("branch_id") @db.Uuid
  code      String
  name      String
  type      AccountType
  createdBy String?     @map("created_by") @db.Uuid
  updatedBy String?     @map("updated_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  isDeleted Boolean     @default(false) @map("is_deleted")

  @@unique([tenantId, companyId, code])
  @@map("chart_of_accounts")
}

model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  rate      Int
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@unique([tenantId, companyId, rate])
  @@map("tax_rates")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  code      String?
  address   Json?
  parentWarehouseId String? @map("parent_warehouse_id") @db.Uuid
  warehouseType String @default("WAREHOUSE") @map("warehouse_type")
  capacity  Decimal? @db.Decimal(18, 3)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([tenantId, companyId, isDeleted])
  @@unique([tenantId, companyId, code])
  @@map("warehouses")
}

model InventoryLocation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String
  name        String
  zone        String?
  bin         String?
  capacity    Decimal? @db.Decimal(18, 3)
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  @@unique([tenantId, warehouseId, code])
  @@index([tenantId, companyId, warehouseId, isDeleted])
  @@map("inventory_locations")
}

model InventoryReservation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  locationId  String?  @map("location_id") @db.Uuid
  quantity    Decimal  @db.Decimal(18, 3)
  referenceId String?  @map("reference_id") @db.Uuid
  referenceType String? @map("reference_type")
  status      String   @default("ACTIVE")
  expiresAt   DateTime? @map("expires_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  @@index([tenantId, companyId, itemId, warehouseId, status])
  @@map("inventory_reservations")
}

model ProductSerial {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  warehouseId String?  @map("warehouse_id") @db.Uuid
  batchId     String?  @map("batch_id") @db.Uuid
  serialNumber String  @map("serial_number")
  status      String   @default("AVAILABLE")
  receivedAt  DateTime? @map("received_at")
  soldAt      DateTime? @map("sold_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  @@unique([tenantId, serialNumber])
  @@index([tenantId, companyId, itemId, status])
  @@map("product_serials")
}

model CycleCount {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  countNumber String   @map("count_number")
  status      String   @default("DRAFT")
  scheduledAt DateTime? @map("scheduled_at")
  completedAt DateTime? @map("completed_at")
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  @@unique([tenantId, countNumber])
  @@index([tenantId, companyId, warehouseId, status])
  @@map("cycle_counts")
}

model CycleCountLine {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  cycleCountId String   @map("cycle_count_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  expectedQty  Decimal  @map("expected_qty") @db.Decimal(18, 3)
  countedQty   Decimal? @map("counted_qty") @db.Decimal(18, 3)
  varianceQty  Decimal? @map("variance_qty") @db.Decimal(18, 3)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isDeleted    Boolean  @default(false) @map("is_deleted")

  @@unique([cycleCountId, itemId])
  @@index([tenantId, companyId, cycleCountId])
  @@map("cycle_count_lines")
}

model PriceList {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  currency  String   @default("INR")

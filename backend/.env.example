# =============================================================================
# Velora ERP — Backend Environment Configuration
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
# =============================================================================

# ── Application ──────────────────────────────────────────────────
NODE_ENV=development                    # development | production
PORT=4000                               # API server port

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/velora_erp

# ── Redis (required for OTP, rate limiting, session cache) ───────
REDIS_URL=redis://localhost:6379

# ── Authentication (JWT) ─────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
ACCESS_TOKEN_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Frontend URL (for CORS and email links) ──────────────────────
FRONTEND_URL=http://localhost:5173

# ── Resend (email delivery for OTP, verification, notifications) ─
# Get a free API key at https://resend.com
# In development, emails are logged to the server console instead of
# being sent. Set these to enable real email delivery.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# OTP_FROM_EMAIL=noreply@yourdomain.com

# ── Advanced ─────────────────────────────────────────────────────
# OTP_HASH_SECRET=optional-separate-secret-for-otp-hashing

# =============================================================================
# Velora ERP — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ---------- Application ----------
NODE_ENV=development                    # development | test | production
PORT=4000                               # Backend API server port

# ---------- Database ----------
# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/velora_erp

# ---------- Redis (required for OTP, rate limiting, caching) ----------
REDIS_URL=redis://localhost:6379

# ---------- Authentication ----------
# Required: Secrets must be at least 24 characters
JWT_ACCESS_SECRET=your-access-secret-min-24-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-24-chars-long
ACCESS_TOKEN_EXPIRES_IN=8h              # Access token lifetime
REFRESH_TOKEN_EXPIRES_IN=7d             # Refresh token lifetime

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173       # Frontend URL (for CORS and email links)

# ---------- Email (Resend) — Required for production email delivery ----------
# Get your API key at https://resend.com
# In development, emails are logged to console instead of sent.
# Set these to enable actual email delivery in production.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# OTP_FROM_EMAIL=noreply@yourdomain.com

# ---------- SMS (Twilio) — Optional, for phone OTP ----------
# Phone verification is optional. Email verification is always available.
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_PHONE=+1234567890

# ---------- Advanced ----------
OTP_HASH_SECRET=                        # Optional: separate secret for OTP hashing (defaults to JWT_ACCESS_SECRET)
